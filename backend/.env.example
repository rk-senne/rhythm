PORT=8080
DATABASE_URL=postgres://rhythm:rhythm@localhost:5432/rhythm?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_BUNDLE_ID=com.yourcompany.rhythm

# APNs push (optional — if unset, notifications are logged, not delivered).
# APNS_KEY_P8 is the PEM contents of your .p8 provider key (newlines preserved).
APNS_KEY_ID=YOUR_KEY_ID
APNS_KEY_P8=
APNS_TOPIC=com.yourcompany.rhythm
APNS_PRODUCTION=false

# AI weekly-summary cost controls (optional; sensible defaults).
AI_SUMMARY_RATE_LIMIT=5
AI_SUMMARY_WINDOW=1h
